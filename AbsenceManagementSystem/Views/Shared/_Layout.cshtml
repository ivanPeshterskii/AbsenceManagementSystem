<body>
    <header class="bg-white border-bottom sticky-top">
        <nav class="navbar navbar-expand-md navbar-light container py-3" aria-label="Main navigation">
            <a class="navbar-brand fw-bold d-flex align-items-center gap-2" asp-controller="Home" asp-action="Index"><span class="brand-icon"><partial name="_GroupIcon" /></span> Absence Management</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navigation" aria-controls="navigation" aria-expanded="false" aria-label="Toggle navigation"><span class="navbar-toggler-icon"></span></button>
            <div class="collapse navbar-collapse" id="navigation">
                <ul class="navbar-nav ms-auto gap-md-2">
                    @foreach (var entry in new[] { ("Home", "Home"), ("Group", "Groups"), ("Child", "Children"), ("Teacher", "Teachers"), ("Absence", "Absences") })
                    {
                        <li class="nav-item"><a class="nav-link px-3 @(ViewContext.RouteData.Values["controller"]?.ToString() == entry.Item1 ? "active" : "")" asp-controller="@entry.Item1" asp-action="Index">@entry.Item2</a></li>
                    }
                </ul>
            </div>
        </nav>
    </header>
    <main class="container py-4 py-lg-5">
        <partial name="_Notifications" />
        @RenderBody()
    </main>
    <footer class="container py-3 small text-muted"><a asp-controller="Home" asp-action="Privacy">About this application</a> · Absence Management</footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
    @await RenderSectionAsync("Styles", required: false)
</body>
