@model IEnumerable<Child>
@{
    ViewData["Title"] = "Children";
}
<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <h1>Children</h1>
        <p class="text-muted mb-0">Manage children and their group assignments.</p>
    </div><a class="btn btn-primary" asp-action="Add">＋ Add Child</a>
</div>
<div class="card p-3">
    <div class="table-responsive">
        <table class="table align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Group</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td><a asp-action="Details" asp-route-id="@item.Id">@item.FirstName @item.LastName</a></td>
                        <td>
                            <a asp-controller="Group" asp-action="Details" asp-route-id="@item.GroupId">@item.Group.Name</a>
                        </td>
                        <td class="text-nowrap">
                            <a asp-action="Edit" asp-route-id="@item.Id"
                               class="btn btn-light btn-sm">Edit</a> <a asp-action="Delete" asp-route-id="@item.Id"
                                                                        class="btn btn-outline-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>@if (!Model.Any())
    {
        <p class="text-muted text-center p-4">
            No children found. Add a group first, then add a
            child.
        </p>
    }
</div>
