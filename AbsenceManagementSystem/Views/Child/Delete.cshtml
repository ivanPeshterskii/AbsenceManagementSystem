@model Child
@{
    ViewData["Title"] = "Delete Child";
}
<h1 class="mb-4">Delete Child</h1>
<div class="card p-4">
    <div class="alert alert-danger">
        This permanently deletes the child and all their absences. This action cannot be
        undone.
    </div>
    <h2 class="h5">@Model.FirstName @Model.LastName</h2>
    <p class="text-muted">@Model.Group.Name</p>
    <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post" class="d-flex justify-content-end gap-2">
        <a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-danger">
            Delete
            Child
        </button>
    </form>
</div>