@model Group
@{
    ViewData["Title"] = Model.Name;
}
<a asp-action="Index" class="d-inline-block mb-3">← Back to Groups</a>
<div class="d-flex justify-content-between align-items-start mb-3">
    <div>
        <h1>@Model.Name</h1>
        <p class="text-muted">Age group: @Model.AgeGroup – @(Model.AgeGroup + 1) years</p>
    </div><a asp-action="GetGroup" asp-route-id="@Model.Id" class="btn btn-primary">Edit Group</a>
</div>
<div class="card p-4 mb-4">
    <div class="row">
        <div class="col-6 d-flex gap-3 align-items-center">
            <span class="avatar">C</span>
            <div>
                <div class="stat-number">@Model.Children.Count</div>Children
            </div>
        </div>
        <div class="col-6 border-start d-flex gap-3 align-items-center">
            <span class="avatar">T</span>
            <div>
                <div class="stat-number">@Model.Teachers.Count</div>Teachers
            </div>
        </div>
    </div>
</div>
<div class="row g-3">
    <div class="col-lg-7">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h6 mb-0">Children in this group (@Model.Children.Count)</h2><a asp-controller="Child"
                                                                                          asp-action="Add" asp-route-groupId="@Model.Id" class="btn btn-primary btn-sm">＋ Add Child</a>
            </div>
            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th>Full Name</th>
                            <th>Absences</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var child in Model.Children.OrderBy(c => c.FirstName).ThenBy(c => c.LastName))
                        {
                            <tr>
                                <td>@child.FirstName @child.LastName</td>
                                <td>@child.Absences.Count</td>
                                <td><a asp-controller="Child" asp-action="Details" asp-route-id="@child.Id">View</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            @if (!Model.Children.Any())
            {
                <p class="text-muted">No children assigned yet.</p>
            }
            <a asp-controller="Child" asp-action="Index" class="small mt-auto">View all children →</a>
        </div>
    </div>
    <div class="col-lg-5">
        <div class="card p-3 h-100">
            <div class="d-flex justify-content-between align-items-center gap-2 mb-3">
                <h2 class="h6 mb-0">Assigned teachers (@Model.Teachers.Count)</h2><a asp-controller="Teacher"
                                                                                     asp-action="Add" asp-route-groupId="@Model.Id" class="btn btn-primary btn-sm">＋ Add Teacher</a>
            </div>
            @foreach (var teacher in Model.Teachers.OrderBy(t => t.FirstName))
            {
                <div class="card p-3 mb-2 d-flex flex-row align-items-center gap-3">
                    <span class="avatar">@teacher.FirstName.Substring(0, 1)</span>
                    <div class="flex-grow-1">
                        <a asp-controller="Teacher" asp-action="Details" asp-route-id="@teacher.Id"
                           class="fw-bold">@teacher.FirstName @teacher.LastName</a>
                        <div class="text-muted small">Teacher</div>
                    </div><a asp-controller="Teacher" asp-action="Edit" asp-route-id="@teacher.Id" class="small">Edit</a>
                </div>
            }
            @if (!Model.Teachers.Any())
            {
                <p class="text-muted">No teachers assigned yet.</p>
            }
            <a asp-controller="Teacher" asp-action="Index" class="small mt-auto pt-3">View all teachers →</a>
        </div>
    </div>
</div>