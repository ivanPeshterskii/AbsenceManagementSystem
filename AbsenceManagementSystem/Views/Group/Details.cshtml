@model AbsenceManagementSystem.Models.Group

@{
    ViewData["Title"] = Model.Name;

    int childrenCount = Model.Children?.Count ?? 0;
    int teachersCount = Model.Teachers?.Count ?? 0;
}

<div class="group-details-page">

    <!-- =====================================================
         TOP SECTION
         ===================================================== -->
    <div class="group-details-header">

        <div class="group-details-heading">

            <a asp-controller="Group"
               asp-action="Index"
               class="back-to-groups">

                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M19 12H5"></path>
                    <path d="M11 18L5 12L11 6"></path>
                </svg>

                <span>Back to Groups</span>
            </a>

            <h1>@Model.Name</h1>

            <p>
                Age group:
                <strong>@Model.AgeGroup years</strong>
            </p>
        </div>

        <a href="#"
           class="edit-group-button">

            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M12 20h9"></path>
                <path d="M16.5 3.5a2.12 2.12 0 0 1 3 3L8 18l-4 1 1-4Z"></path>
            </svg>

            <span>Edit Group</span>
        </a>

    </div>


    <!-- =====================================================
         GROUP STATISTICS
         ===================================================== -->
    <div class="group-details-summary">

        <div class="details-stat">

            <div class="details-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="9" cy="7" r="3"></circle>
                    <circle cx="17" cy="8" r="2.5"></circle>
                    <path d="M3 20v-2c0-3 2.7-5 6-5s6 2 6 5v2"></path>
                    <path d="M15 14c3 0 5 1.8 5 4.5V20"></path>
                </svg>
            </div>

            <div class="details-stat-content">
                <strong>@childrenCount</strong>
                <span>Children</span>
            </div>

        </div>

        <div class="details-stat-divider"></div>

        <div class="details-stat">

            <div class="details-stat-icon teacher-stat-icon">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <circle cx="12" cy="7" r="4"></circle>
                    <path d="M5 21v-2c0-4 3-6 7-6s7 2 7 6v2"></path>
                </svg>
            </div>

            <div class="details-stat-content">
                <strong>@teachersCount</strong>
                <span>Teachers</span>
            </div>

        </div>

    </div>


    <!-- =====================================================
         LOWER SECTION
         ===================================================== -->
    <div class="group-details-content">

        <!-- =================================================
             CHILDREN
             ================================================= -->
        <section class="details-panel children-panel">

            <div class="details-panel-header">

                <h2>
                    Children in this group
                    <span>(@childrenCount)</span>
                </h2>

                <a href="#" class="details-add-button">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>

                    <span>Add Child</span>
                </a>

            </div>


            @if (childrenCount > 0)
            {
                <div class="children-table-wrapper">

                    <table class="children-table">

                        <thead>
                            <tr>
                                <th class="number-column">#</th>
                                <th>Full Name</th>
                                <th>Absences</th>
                                <th class="actions-column">Actions</th>
                            </tr>
                        </thead>

                        <tbody>

                            @{
                                int childNumber = 1;
                            }

                            @foreach (var child in Model.Children)
                            {
                                <tr>

                                    <td class="number-column">
                                        @childNumber
                                    </td>

                                    <td class="child-name">
                                        @child.FirstName @child.LastName
                                    </td>

                                    <td>
                                        <span class="absence-count">
                                            @child.Absences.Count
                                        </span>
                                    </td>

                                    <td class="actions-column">

                                        <a href="#"
                                           class="table-action-button"
                                           title="View child">

                                            <svg viewBox="0 0 24 24" aria-hidden="true">
                                                <path d="M2 12s3.5-6 10-6 10 6 10 6-3.5 6-10 6S2 12 2 12Z"></path>
                                                <circle cx="12" cy="12" r="2.5"></circle>
                                            </svg>

                                        </a>

                                    </td>

                                </tr>

                                childNumber++;
                            }

                        </tbody>

                    </table>

                </div>

                <a href="#"
                   class="view-all-children">

                    <span>View all children</span>

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M5 12h14"></path>
                        <path d="M13 6l6 6-6 6"></path>
                    </svg>

                </a>
            }
            else
            {
                <div class="details-empty-state">
                    No children have been added to this group yet.
                </div>
            }

        </section>


        <!-- =================================================
             TEACHERS
             ================================================= -->
        <section class="details-panel teachers-panel">

            <div class="details-panel-header">

                <h2>
                    Assigned teachers
                    <span>(@teachersCount)</span>
                </h2>

                <a href="#" class="details-add-button">

                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M12 5v14"></path>
                        <path d="M5 12h14"></path>
                    </svg>

                    <span>Assign Teacher</span>
                </a>

            </div>


            <div class="teachers-list">

                @if (teachersCount > 0)
                {
                    @foreach (var teacher in Model.Teachers)
                    {
                        <div class="teacher-card">

                            <div class="teacher-avatar">

                                <svg viewBox="0 0 24 24" aria-hidden="true">
                                    <circle cx="12" cy="7" r="4"></circle>
                                    <path d="M5 21v-2c0-4 3-6 7-6s7 2 7 6v2"></path>
                                </svg>

                            </div>

                            <div class="teacher-information">

                                <strong>
                                    @teacher.FirstName @teacher.LastName
                                </strong>

                                <span>Teacher</span>

                            </div>

                            <div class="teacher-actions">

                                <a href="#"
                                   class="teacher-action-button"
                                   title="Teacher details">

                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                        <path d="m3 7 9 6 9-6"></path>
                                    </svg>

                                </a>

                                <a href="#"
                                   class="teacher-action-button remove-teacher-button"
                                   title="Remove teacher">

                                    <svg viewBox="0 0 24 24" aria-hidden="true">
                                        <path d="M3 6h18"></path>
                                        <path d="M8 6V4h8v2"></path>
                                        <path d="M19 6l-1 14H6L5 6"></path>
                                        <path d="M10 10v6"></path>
                                        <path d="M14 10v6"></path>
                                    </svg>

                                </a>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="details-empty-state">
                        No teachers are assigned to this group.
                    </div>
                }

            </div>

        </section>

    </div>

</div>