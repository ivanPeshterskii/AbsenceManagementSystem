@model Group
@{
    ViewData["Title"] = "Delete Group";
}
<a asp-action="Index" class="d-inline-block mb-4">← Back to Groups</a>
<div class="row g-4">
    <div class="col-lg-4">
        <h1>Delete Group</h1>
        <p class="text-muted">Are you sure you want to delete this group?</p>
    </div>
    <div class="col-lg-8">
        <div class="card p-4">
            <div class="alert alert-danger">
                <strong>This action cannot be undone.</strong><br />The group, its
                @Model.Children.Count children, their @Model.Children.Sum(c => c.Absences.Count) absences and its
                @Model.Teachers.Count teachers will be permanently deleted.
            </div>
            <div class="d-flex align-items-center gap-3 mb-4">
                <span class="avatar">
                    <partial name="_GroupIcon" />
                </span>
                <div>
                    <h2 class="h5">@Model.Name</h2><span class="text-muted">
                        Age group: @Model.AgeGroup –
                        @(Model.AgeGroup + 1) years
                    </span>
                </div>
            </div>
            <form asp-action="DeleteConfirmed" asp-route-id="@Model.Id" method="post"
                  class="d-flex justify-content-end gap-2">
                <a asp-action="Index" class="btn btn-light">Cancel</a><button type="submit" class="btn btn-danger">
                    Delete Group
                </button>
            </form>
        </div>
    </div>
</div>
