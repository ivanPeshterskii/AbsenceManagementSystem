@model IEnumerable<Group>
@{ ViewData["Title"] = "Groups"; var groups = Model.ToList(); }
<div class="d-flex justify-content-between align-items-start gap-3 mb-4">
    <div><h1>Groups</h1><p class="text-muted mb-0">Manage kindergarten groups, children and assigned teachers.</p></div>
    <a class="btn btn-primary text-nowrap" asp-action="Add">＋ Add Group</a>
</div>
@if (groups.Any())
{
    <div class="row g-3 mb-4">
        <div class="col-md-4"><div class="card p-3 d-flex flex-row gap-3 align-items-center"><span class="avatar"><partial name="_GroupIcon" /></span><div><div class="stat-number">@groups.Count</div><span class="text-muted">Groups</span></div></div></div>
        <div class="col-md-4"><a asp-controller="Child" asp-action="Index" class="card p-3 d-flex flex-row gap-3 align-items-center text-reset"><span class="avatar">C</span><div><div class="stat-number">@groups.Sum(g => g.Children.Count)</div><span class="text-muted">Children →</span></div></a></div>
        <div class="col-md-4"><a asp-controller="Teacher" asp-action="Index" class="card p-3 d-flex flex-row gap-3 align-items-center text-reset"><span class="avatar">T</span><div><div class="stat-number">@groups.Sum(g => g.Teachers.Count)</div><span class="text-muted">Teachers →</span></div></a></div>
    </div>
    <div class="row g-3 group-grid">
        @foreach (var group in groups)
        {
            <div class="col-md-6">
                <div class="card p-4 h-100">
                    <div class="d-flex gap-3">
                        <span class="avatar" aria-hidden="true"><partial name="_GroupIcon" /></span>
                        <div class="flex-grow-1">
                            <h2 class="h5">@group.Name</h2><p class="text-muted small">Age group: @group.AgeGroup – @(group.AgeGroup + 1) years</p>
                            <div class="d-flex flex-wrap gap-3 small mb-3"><span><strong>@group.Children.Count</strong> Children</span><span><strong>@group.Teachers.Count</strong> Teachers</span></div>
                            <div class="d-flex gap-2 flex-wrap"><a asp-action="Details" asp-route-id="@group.Id" class="btn btn-soft flex-grow-1">View Details</a><a asp-action="GetGroup" asp-route-id="@group.Id" class="btn btn-light" aria-label="Edit @group.Name">Edit</a><a asp-action="Delete" asp-route-id="@group.Id" class="btn btn-outline-danger" aria-label="Delete @group.Name">Delete</a></div>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="card p-5 text-center align-items-center"><span class="avatar mb-3"><partial name="_GroupIcon" /></span><h2 class="h5">No groups found</h2><p class="text-muted">Start by creating your first kindergarten group.</p><a class="btn btn-primary" asp-action="Add">＋ Add Group</a></div>
}
