@model AbsenceManagementSystem.Models.Group

@{
    ViewData["Title"] = $"Update {Model.Name}";
}

<h1>Edit group</h1>

<form asp-controller="Group"
      asp-action="UpdateGroup"
      asp-route-id="@Model.Id"
      method="post">

    <div asp-validation-summary="All"
         class="text-danger"></div>

    <input asp-for="Id" type="hidden" />

    <div class="mb-3">
        <label asp-for="Name" class="form-label">
            Group name
        </label>

        <input asp-for="Name" class="form-control" />

        <span asp-validation-for="Name"
              class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="AgeGroup" class="form-label">
            Age group
        </label>

        <input asp-for="AgeGroup"
               type="number"
               class="form-control" />

        <span asp-validation-for="AgeGroup"
              class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary">
        Save changes
    </button>

    <a asp-controller="Group"
       asp-action="Index"
       class="btn btn-secondary">
        Cancel
    </a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}