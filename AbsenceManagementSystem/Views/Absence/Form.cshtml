@model AbsenceManagementSystem.DTOs.Absences.AbsenceDto
@{
    var editing = Model.Id > 0; ViewData["Title"] = editing ? "Edit Absence" : "Record Absence";
}
<a asp-action="Index" class="d-inline-block mb-4">← Back to Absences</a>
<div class="row g-4">
    <div class="col-lg-4">
        <h1>@ViewData["Title"]</h1>
        <p class="text-muted">Record one absence per child and date.</p><a asp-controller="Child" asp-action="Add">
            Add a
            child →
        </a>
    </div>
    <div class="col-lg-7">
        <div class="card p-4">
            <form asp-action="@(editing ? "Edit" : "Add")" asp-route-id="@(editing ? Model.Id : (int?)null)"
                  method="post">
                <input asp-for="Id" type="hidden" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="ChildId" class="form-label"></label><select asp-for="ChildId"
                                                                                asp-items="ViewBag.Children" class="form-select">
                        <option value="">Select child</option>
                    </select><span asp-validation-for="ChildId" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Date" class="form-label"></label><input asp-for="Date"
                                                                            class="form-control" /><span asp-validation-for="Date" class="text-danger small"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Type" class="form-label"></label><select asp-for="Type"
                                                                             asp-items="Html.GetEnumSelectList<AbsenceManagementSystem.Models.Enum.AbsenceType>()"
                                                                             class="form-select">
                        <option value="">Select reason</option>
                    </select><span asp-validation-for="Type" class="text-danger small"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Note" class="form-label"></label><textarea asp-for="Note"
                                                                               class="form-control" rows="3"></textarea><span asp-validation-for="Note"
                                                                                                                              class="text-danger small"></span>
                </div>
                <div class="d-flex justify-content-end gap-2">
                    <a asp-action="Index"
                       class="btn btn-light">Cancel</a><button type="submit" class="btn btn-primary">
                        Save
                        Absence
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}